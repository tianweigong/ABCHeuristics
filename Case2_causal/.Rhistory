set.seed(2)
#Full Vector: all 12 cues (2 components * 2 types of cues * 3 interventions)
myCue_FullFea<-function(df){
c(df$ss_count_i_A_1[1],
df$ss_count_i_A_2[1],
df$ss_count_i_A_3[1],
df$ss_count_i_B_1[1],
df$ss_count_i_B_2[1],
df$ss_count_i_B_3[1],
df$ss_delay_i_A_1[1],
df$ss_delay_i_A_2[1],
