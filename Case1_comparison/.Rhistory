# Fit regularized logistic model by MAP estimation.
fit_regularized_benchmark <- function(tr,
sigma = 1,
lambda = 0.5,
max_order = ncol(tr)) {
dat <- make_pairwise_training(tr, max_order = max_order)
X_pair <- dat$X_pair
y <- dat$y
order_vec <- dat$order
# Prior standard deviation for each weight
tau <- sigma * lambda^(order_vec - 1)
neg_log_posterior <- function(w) {
eta <- as.vector(X_pair %*% w)
# Negative log likelihood for Bernoulli-logistic model
nll <- sum(log1pexp(eta) - y * eta)
# Gaussian prior penalty
prior_penalty <- 0.5 * sum((w / tau)^2)
nll + prior_penalty
}
fit <- optim(
par = rep(0, ncol(X_pair)),
fn = neg_log_posterior,
method = "BFGS",
control = list(maxit = 5000)
)
list(
w_hat = fit$par,
feature_names = dat$feature_names,
order = order_vec,
sigma = sigma,
lambda = lambda,
max_order = max_order,
convergence = fit$convergence,
value = fit$value
)
}
predict_two_insects <- function(model, V1, V2) {
X <- rbind(as.numeric(strsplit(V1, "")[[1]]),
as.numeric(strsplit(V2, "")[[1]]))
feat <- make_phi(X, max_order = model$max_order)
Phi <- feat$Phi
delta_phi <- Phi[1, ] - Phi[2, ]
eta <- sum(delta_phi * model$w_hat)
p_V1_greater_V2 <- sigmoid(eta)
data.frame(
p_V1_greater_V2 = p_V1_greater_V2,
p_V2_greater_V1 = 1 - p_V1_greater_V2,
choice = ifelse(p_V1_greater_V2 > 0.5, "V1", "V2")
)
}
# Chunk 6
#generate model answers for each environment
myRun<-function(par){
k=par[1]
nam=names(vali_list)[k] %>% as.numeric()
set.seed(nam)
tr=tr_ori[order(sample(1:16)),]
model_reg <- fit_regularized_benchmark(
tr = tr,
sigma = 10,
lambda = 0.5,
max_order = 1
)
df.li=df.ref %>%mutate(choosingV1=NA,choosingV2=NA,choice=NA)
for (j in 1:nrow(df.li)){
re=predict_two_insects(model_reg,df.ref$V1[j],df.ref$V2[j])
df.li$choosingV1[j]=re$p_V1_greater_V2[1]
df.li$choosingV2[j]=re$p_V2_greater_V1[1]
df.li$choice[j]=re$choice[1]
}
save(df.li,k,vali_list,file=
paste0("results_regularized/envir",k,".Rda"))
}
tmp=expand.grid(k=c(1:100)) %>% arrange_all()
wholelist=split(tmp,seq(nrow(tmp))) %>%
lapply(function(row) as.numeric(row))
mclapply(wholelist, myRun,mc.cores = 8)
myApp<-function(df.App){
v1_nor=as.numeric(df.li$choosingV1>0.5)
v2_nor=as.numeric(df.li$choosingV2>0.5)
df.App$ttb[1]= mean(v1_nor*df.li1$V1_ttb+v2_nor*df.li1$V2_ttb)
df.App$tal[1]= mean(v1_nor*df.li1$V1_tal+v2_nor*df.li1$V2_tal)
df.App$ttb_ss[1]=mean(v1_nor*df.li2$V1_ss+v2_nor*df.li2$V2_ss)
df.App$tal_ss_0[1]=mean(v1_nor*df.li3$V1_ss+v2_nor*df.li3$V2_ss,na.rm=T)
df.App$tal_ss_1[1]=mean(v1_nor*df.li4$V1_ss+v2_nor*df.li4$V2_ss,na.rm=T)
df.App
}
