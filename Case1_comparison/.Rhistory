# Chunk 1
library(dplyr)
library(tidyr)
library(ggplot2)
library(data.table)
library(patchwork)
library(parallel)
set.seed(2)
# Chunk 2
#16 insects used for training
tr_ori=rbind(c(0,0,0,1,0,0), #1
c(0,1,0,0,1,0), #2
c(0,0,1,0,0,1), #3
c(0,0,0,1,1,0), #4
c(0,0,0,0,1,0), #5
c(1,0,0,0,1,1), #6
c(0,0,1,1,1,1), #7
c(1,1,0,1,0,0), #8
c(1,1,1,0,0,1), #9
c(1,1,0,0,1,0), #10
c(1,1,0,1,1,1), #11
c(1,1,1,1,0,0), #12
c(1,1,1,1,1,1),  #13
c(1,1,1,1,0,1), #14
c(1,1,1,0,1,0), #15
c(1,1,1,1,1,0) #16
)
# Chunk 3
#generate training environments
tr=tr_ori
vali_list=list()
for (k in 1:20000){ #5000
set.seed(k)
tr=tr_ori[order(sample(1:16)),]
vali=rep(NA,6)
for (i in 1:6){
idx_A=which(tr[,i]==0)
idx_B=which(tr[,i]==1)
dcorrect=sum(outer(idx_A, idx_B, function(x, y) y > x))
dtotal=length(idx_A)*length(idx_B)
vali[i]=(dcorrect+1)/(dtotal+2)
}
if (sum(vali>0.5)>=6){ #only keep those having all positive cues
vali_list[[as.character(k)]]=vali
}
}
#check cue validity in all environments.
unlist(vali_list) %>% quantile()
# sapply(vali_list,sd) %>% hist
# which.max(sapply(vali_list,sd))
# Chunk 4
#generate testing set, i.e. all 2016 pairwise comparisons among 64 insects
tr_cha=tr_ori %>% apply(1, function(x){as.character(x) %>% paste(collapse = "")})
sti=expand.grid(c(0,1),c(0,1),c(0,1),c(0,1),c(0,1),c(0,1)) %>%
apply(1, function(x){as.character(x) %>% paste(collapse = "")})
#remove those comparisons that have appeared in the training set
xx=combn(sti, 2) %>% t%>% as.data.frame()
# intersect(which(xx$V1 %in% tr_cha),which(xx$V2 %in% tr_cha))
df.ref=xx[-intersect(which(xx$V1 %in% tr_cha),which(xx$V2 %in% tr_cha)),]
# intersect(which(xx2$V1 %in% tr_cha),which(xx2$V2 %in% tr_cha))
# Chunk 5
sigmoid <- function(x) {
1 / (1 + exp(-x))
}
log1pexp <- function(x) {
# numerically stable log(1 + exp(x))
out <- numeric(length(x))
idx <- x > 0
out[idx] <- x[idx] + log1p(exp(-x[idx]))
out[!idx] <- log1p(exp(x[!idx]))
out
}
# Create feature matrix phi(x), including all interactions up to max_order.
# X should be n x 6, coded as 0/1.
make_phi <- function(X, max_order = ncol(X)) {
X <- as.matrix(X)
# Convert 0/1 cues to -1/+1 coding
U <- 2 * X - 1
K <- ncol(U)
phi_list <- list()
order_vec <- c()
name_vec <- c()
for (k in 1:max_order) {
cmb <- combn(K, k, simplify = FALSE)
for (s in cmb) {
phi_list[[length(phi_list) + 1]] <- apply(U[, s, drop = FALSE], 1, prod)
order_vec <- c(order_vec, k)
name_vec <- c(name_vec, paste0("order", k, "_", paste(s, collapse = "_")))
}
}
Phi <- do.call(cbind, phi_list)
colnames(Phi) <- name_vec
list(
Phi = Phi,
order = order_vec,
names = name_vec
)
}
# Construct pairwise training data from ranked insects.
# Rows of tr are assumed to be ordered from least poisonous to most poisonous.
make_pairwise_training <- function(tr, max_order = ncol(tr)) {
feat <- make_phi(tr, max_order = max_order)
Phi <- feat$Phi
n <- nrow(tr)
pairs <- combn(n, 2)
n_pairs <- ncol(pairs)
X_pair <- matrix(NA, nrow = n_pairs, ncol = ncol(Phi))
y <- numeric(n_pairs)
for (m in 1:n_pairs) {
i <- pairs[1, m]
j <- pairs[2, m]
# Consistent with your validity code:
# larger row index = more poisonous
X_pair[m, ] <- Phi[j, ] - Phi[i, ]
y[m] <- 1
}
colnames(X_pair) <- colnames(Phi)
list(
X_pair = X_pair,
y = y,
order = feat$order,
feature_names = feat$names
)
}
# Fit regularized logistic model by MAP estimation.
fit_regularized_benchmark <- function(tr,
sigma = 1,
lambda = 0.5,
max_order = ncol(tr)) {
dat <- make_pairwise_training(tr, max_order = max_order)
X_pair <- dat$X_pair
y <- dat$y
order_vec <- dat$order
# Prior standard deviation for each weight
tau <- sigma * lambda^(order_vec - 1)
neg_log_posterior <- function(w) {
eta <- as.vector(X_pair %*% w)
# Negative log likelihood for Bernoulli-logistic model
nll <- sum(log1pexp(eta) - y * eta)
# Gaussian prior penalty
prior_penalty <- 0.5 * sum((w / tau)^2)
nll + prior_penalty
}
fit <- optim(
par = rep(0, ncol(X_pair)),
fn = neg_log_posterior,
method = "BFGS",
control = list(maxit = 5000)
)
list(
w_hat = fit$par,
feature_names = dat$feature_names,
order = order_vec,
sigma = sigma,
lambda = lambda,
max_order = max_order,
convergence = fit$convergence,
value = fit$value
)
}
predict_two_insects <- function(model, V1, V2) {
X <- rbind(as.numeric(strsplit(V1, "")[[1]]),
as.numeric(strsplit(V2, "")[[1]]))
feat <- make_phi(X, max_order = model$max_order)
Phi <- feat$Phi
delta_phi <- Phi[1, ] - Phi[2, ]
eta <- sum(delta_phi * model$w_hat)
p_V1_greater_V2 <- sigmoid(eta)
data.frame(
p_V1_greater_V2 = p_V1_greater_V2,
p_V2_greater_V1 = 1 - p_V1_greater_V2,
choice = ifelse(p_V1_greater_V2 > 0.5, "V1", "V2")
)
}
# Chunk 6
#generate model answers for each environment
myRun<-function(par){
k=par[1]
nam=names(vali_list)[k] %>% as.numeric()
set.seed(nam)
tr=tr_ori[order(sample(1:16)),]
model_reg <- fit_regularized_benchmark(
tr = tr,
sigma = 10,
lambda = 0.5,
max_order = 1
)
df.li=df.ref %>%mutate(choosingV1=NA,choosingV2=NA,choice=NA)
for (j in 1:nrow(df.li)){
re=predict_two_insects(model_reg,df.ref$V1[j],df.ref$V2[j])
df.li$choosingV1[j]=re$p_V1_greater_V2[1]
df.li$choosingV2[j]=re$p_V2_greater_V1[1]
df.li$choice[j]=re$choice[1]
}
save(df.li,k,vali_list,file=
paste0("results_regularized/envir",k,".Rda"))
}
